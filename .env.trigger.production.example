# Template only. Fill .env.trigger.production.local (ignored), or Trigger's UI.
# Trigger.dev project environment: prod. This is NOT Netlify's environment.
APP_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Keep delivery disabled until verified and separately enabled.
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CALENDAR_WRITES_ENABLED=false
SOCIAL_COLLECTION_ENABLED=false
# No NEXT_PUBLIC_* keys. Do not copy Netlify's TRIGGER_SECRET_KEY here.
# Deployment account tokens belong only in local/CI auth, never worker settings.
