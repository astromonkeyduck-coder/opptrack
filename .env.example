# Local development only; do not import this combined file into hosted production.
# Production uses .env.netlify.production.example and .env.trigger.production.example.
# Stage 0 needs no credentials for the public-source probes.
# Names only. Never put actual tokens in the registry, captures, Git, or logs.
# Stage 1, when authorized:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
TRIGGER_SECRET_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Later optional social read probes; consult scripts/social_probe.py --help.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_API_VERSION=
APIFY_TOKEN=
APIFY_DATASET_ID=
# Calendar remains disabled until the separately authorized calendar stage.
CALENDAR_WRITES_ENABLED=false

# Non-secret development config; set before using a verified Trigger CLI.
TRIGGER_PROJECT_REF=
APP_URL=http://localhost:3000
