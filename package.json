{
  "name": "fsu-opportunity-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Private FSU opportunity collection and review inbox",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "node scripts/test-database.mjs && node scripts/test-hourly-database.mjs && node scripts/test-instagram-database.mjs && node scripts/test-review-database.mjs && npm run test:instagram:replay && node --import tsx scripts/test-hq-database.mjs && node --import tsx scripts/test-official-database.mjs",
    "collect:live": "node --import tsx scripts/collect-live.ts",
    "dispatch": "node --import tsx scripts/dispatch.ts",
    "setup:owner": "node scripts/setup-owner.mjs",
    "setup:sources": "node --import tsx scripts/setup-sources.ts",
    "check:env": "node scripts/check-local-env.mjs",
    "prove:live": "node --import tsx scripts/prove-live-database.mjs",
    "evidence:inbox": "node --import tsx scripts/render-live-inbox.ts",
    "retention:plan": "node --import tsx scripts/purge-expired.ts",
    "test:instagram:replay": "node --import tsx scripts/prove-instagram-replay.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@trigger.dev/sdk": "4.7.6",
    "cheerio": "1.2.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@netlify/plugin-nextjs": "5.16.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ws": "8.22.0",
    "deepmerge-ts": "8.0.2"
  },
  "type": "module"
}
