# Template only. Fill .env.netlify.production.local (ignored), or Netlify's UI.
# Netlify context: Production. See config/production-environments.json for scopes.
# Public values: Builds + Functions. NEXT_PUBLIC_* is bundled into browser code.
APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret: Functions scope when supported by the plan. Never NEXT_PUBLIC_*.
# Optional and unused by Stage 1 web routes. Future enqueue uses a Production key.
TRIGGER_SECRET_KEY=
# Keep external calendar writes disabled until the approved calendar stage.
CALENDAR_WRITES_ENABLED=false
# Optional inbound webhook; set the secret only when this feature is implemented.
INBOUND_EMAIL_ENABLED=false
RESEND_WEBHOOK_SECRET=
# Optional owner-authorized read-only Google Calendar. Netlify server functions only.
# Never prefix these with NEXT_PUBLIC_; never copy them to Trigger.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exactly 32 random bytes, encoded as base64. Keep stable; rotation requires reconnect.
CALENDAR_TOKEN_ENCRYPTION_KEY=
# No Google access/refresh token is an environment value. Tokens are encrypted in the DB.
# Do not add SUPABASE_SECRET_KEY, RESEND_API_KEY, social or Google tokens here.
